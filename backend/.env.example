DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
SECRET_KEY=replace-with-a-long-random-secret

# ML artifacts (defaults are relative to the repository root)
PREMIUM_MODEL_PATH=ml/premium/models/premium_model.pkl
CLAIM_MODEL_PATH=ml/claim_fraud/models/claim_fraud_model.pkl

# Local KYC YOLO detectors. These files belong in backend/models/.
KYC_DL_MODEL_PATH=backend/models/dl_detector.pt
KYC_AADHAAR_MODEL_PATH=backend/models/aadhaar_detector.pt
KYC_PAN_MODEL_PATH=backend/models/pan_detector.pt
KYC_MODEL_DEVICE=cpu
KYC_MODEL_IMGSZ=640
KYC_MODEL_CONF=0.25

# Roboflow is now optional for KYC detection. If ROBOFLOW_API_KEY is set,
# it is used only for OCR; otherwise pytesseract is used locally.
ROBOFLOW_API_KEY=
ROBOFLOW_DL_MODEL_ID=indian-driving-licence-reader-rlxel/1
ROBOFLOW_AADHAAR_MODEL_ID=
ROBOFLOW_PAN_MODEL_ID=

# Razorpay Payments (Test Mode first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Cloudinary claim evidence storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web3 audit / insurance state
WEB3_RPC_URL=http://127.0.0.1:8545
WEB3_CHAIN_ID=31337
BLOCKCHAIN_INR_TO_WEI=1000000000000
DRIVER_REGISTRY_ADDRESS=
SAFETY_SCORE_ORACLE_ADDRESS=
INSURANCE_POOL_ADDRESS=
INSURANCE_POLICY_ADDRESS=
CLAIM_MANAGER_ADDRESS=
ORACLE_ADDRESS=
INSURANCE_COMPANY_ADDRESS=
INSURANCE_COMPANY_PRIVATE_KEY=
