DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
SECRET_KEY=replace-with-a-long-random-secret

# ML artifacts (defaults are relative to the repository root)
PREMIUM_MODEL_PATH=ml/premium/models/premium_model.pkl
CLAIM_MODEL_PATH=ml/claim_fraud/models/claim_fraud_model.pkl

# Razorpay Payments (Test Mode first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# RazorpayX payouts to worker UPI IDs
RAZORPAYX_ACCOUNT_NUMBER=

# Cloudinary claim evidence storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web3 audit / insurance state
WEB3_RPC_URL=http://127.0.0.1:8545
WEB3_CHAIN_ID=31337
BLOCKCHAIN_INR_TO_WEI=1000000000000
DRIVER_REGISTRY_ADDRESS=
SAFETY_SCORE_ORACLE_ADDRESS=
INSURANCE_POOL_ADDRESS=
INSURANCE_POLICY_ADDRESS=
CLAIM_MANAGER_ADDRESS=

# Backend signer used for insurer/oracle blockchain operations.
# The deployment account must grant this address the required roles.
# NEVER commit a real private key.
ORACLE_ADDRESS=
INSURANCE_COMPANY_ADDRESS=
INSURANCE_COMPANY_PRIVATE_KEY=

# Roboflow document AI / OCR
# Keep the API key server-side; never expose it through Vite/frontend variables.
ROBOFLOW_API_KEY=
ROBOFLOW_DL_MODEL_ID=indian-driving-licence-reader-rlxel/1
