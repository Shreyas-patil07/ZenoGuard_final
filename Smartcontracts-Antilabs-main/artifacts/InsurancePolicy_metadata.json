		"devdoc": {
			"author": "Senior Solidity Architect",
			"details": "Off-chain actuarial pricing (the \"base premium\" for a given coverage      amount) is computed by the backend and passed in at purchase/renewal      time; this contract's only on-chain pricing responsibility is the      deterministic tier adjustment below:        Score 90-100  => 20% discount  (80% of base premium)        Score 75-89   => normal premium (100% of base premium)        Score 60-74   => 10% surcharge (110% of base premium)        Score 0-59    => normal premium, policy flagged `underReview`      Role model:      - DEFAULT_ADMIN_ROLE: grants/revokes roles below; multisig/timelock        in production.      - PAUSER_ROLE: may pause/unpause this contract in an emergency.      - INSURANCE_COMPANY_ROLE: may administratively update a policy's        premium and force-cancel policies (e.g. fraud response).      This contract must itself hold POLICY_MANAGER_ROLE on DriverRegistry      to call `linkPolicy`, granted post-deployment by the DriverRegistry      admin (see deploy.js).",
			"errors": {
				"AccessControlBadConfirmation()": [
					{
						"details": "The caller of a function is not the expected one. NOTE: Don't confuse with {AccessControlUnauthorizedAccount}."
					}
				],
				"AccessControlUnauthorizedAccount(address,bytes32)": [
					{
						"details": "The `account` is missing a role."
					}
				],
				"DriverNotRegistered(address)": [
					{
						"params": {
							"wallet": "The unrecognized wallet address."
						}
					}
				],
				"EnforcedPause()": [
					{
						"details": "The operation failed because the contract is paused."
					}
				],
				"ExpectedPause()": [
					{
						"details": "The operation failed because the contract is not paused."
					}
				],
				"IncorrectPremiumAmount(uint256,uint256)": [
					{
						"params": {
							"required": "The expected premium amount in wei.",
							"sent": "The amount actually sent in wei."
						}
					}
				],
				"NotPolicyOwner(address,uint256)": [
					{
						"params": {
							"caller": "The address that attempted the action.",
							"policyId": "The policy ID they attempted to act on."
						}
					}
				],
				"PolicyAlreadyActive(address)": [
					{
						"params": {
							"driver": "The driver wallet with an existing active policy."
						}
					}
				],
				"PolicyNotFound(uint256)": [
					{
						"params": {
							"policyId": "The unrecognized policy ID."
						}
					}
				],
				"ReentrancyGuardReentrantCall()": [
					{
						"details": "Unauthorized reentrant call."
					}
				]
			},
			"events": {
				"EmergencyPaused(address)": {
					"params": {
						"pausedBy": "The address that triggered the pause."
					}
				},
				"EmergencyUnpaused(address)": {
					"params": {
						"unpausedBy": "The address that lifted the pause."
					}
				},
				"Paused(address)": {
					"details": "Emitted when the pause is triggered by `account`."
				},
				"PolicyCancelled(uint256,address)": {
					"params": {
						"cancelledBy": "The address that initiated the cancellation.",
						"policyId": "The cancelled policy ID."
					}
				},
				"PolicyPurchased(uint256,address,uint256,uint256,uint64)": {
					"params": {
						"coverage": "The maximum payout coverage, in wei.",
						"driver": "The driver the policy belongs to.",
						"expiryTime": "The unix timestamp the policy expires.",
						"policyId": "The newly created policy ID.",
						"premium": "The premium paid, in wei."
					}
				},
				"PolicyRenewed(uint256,uint256,uint64)": {
					"params": {
						"newExpiryTime": "The new expiry timestamp.",
						"newPremium": "The updated premium, in wei.",
						"policyId": "The renewed policy ID."
					}
				},
				"PremiumUpdated(uint256,uint256,uint256)": {
					"params": {
						"newPremium": "The new premium, in wei.",
						"oldPremium": "The previous premium, in wei.",
						"policyId": "The affected policy ID."
					}
				},
				"RoleAdminChanged(bytes32,bytes32,bytes32)": {
					"details": "Emitted when `newAdminRole` is set as ``role``'s admin role, replacing `previousAdminRole` `DEFAULT_ADMIN_ROLE` is the starting admin for all roles, despite {RoleAdminChanged} not being emitted to signal this."
				},
				"RoleGranted(bytes32,address,address)": {
					"details": "Emitted when `account` is granted `role`. `sender` is the account that originated the contract call. This account bears the admin role (for the granted role). Expected in cases where the role was granted using the internal {AccessControl-_grantRole}."
				},
				"RoleRevoked(bytes32,address,address)": {
					"details": "Emitted when `account` is revoked `role`. `sender` is the account that originated the contract call:   - if using `revokeRole`, it is the admin role bearer   - if using `renounceRole`, it is the role bearer (i.e. `account`)"
				},
				"Unpaused(address)": {
					"details": "Emitted when the pause is lifted by `account`."
				}
			},
			"kind": "dev",
			"methods": {
				"cancelPolicy(uint256)": {
					"details": "Callable by the policy's driver, or by an INSURANCE_COMPANY_ROLE      holder (e.g. fraud response / regulatory action). No premium      refund logic is applied — out of scope for this lean build.",
					"params": {
						"policyId": "The policy ID to cancel."
					}
				},
				"constructor": {
					"params": {
						"admin": "The address to receive DEFAULT_ADMIN_ROLE and PAUSER_ROLE.",
						"driverRegistry_": "Deployed DriverRegistry contract address.",
						"insurancePool_": "Deployed InsurancePool contract address.",
						"safetyScoreOracle_": "Deployed SafetyScoreOracle contract address."
					}
				},
				"getPolicy(uint256)": {
					"details": "Reverts with `PolicyNotFound` if `policyId` does not exist.",
					"params": {
						"policyId": "The policy ID to look up."
					},
					"returns": {
						"policy": "The `InsuranceTypes.Policy` record."
					}
				},
				"getRoleAdmin(bytes32)": {
					"details": "Returns the admin role that controls `role`. See {grantRole} and {revokeRole}. To change a role's admin, use {_setRoleAdmin}."
				},
				"grantRole(bytes32,address)": {
					"details": "Grants `role` to `account`. If `account` had not been already granted `role`, emits a {RoleGranted} event. Requirements: - the caller must have ``role``'s admin role. May emit a {RoleGranted} event."
				},
				"hasRole(bytes32,address)": {
					"details": "Returns `true` if `account` has been granted `role`."
				},
				"isPolicyActive(uint256)": {
					"details": "Lazy-expiry check: a policy is active only if its `active` flag      is set AND the current block timestamp has not passed its      `expiryTime`. No state transition transaction is required for a      policy to be treated as expired.",
					"params": {
						"policyId": "The policy ID to check."
					},
					"returns": {
						"active": "True if the policy is in force right now."
					}
				},
				"paused()": {
					"details": "Returns true if the contract is paused, and false otherwise."
				},
				"purchasePolicy(uint256,uint256)": {
					"details": "`basePremium` is the off-chain-computed actuarial premium for      `coverageAmount`, supplied by the backend/frontend; this function      applies the deterministic score-tier adjustment on top of it and      requires exact payment of the resulting amount. Reverts if the      caller is not a registered driver, already holds an active      policy, or sends the wrong ETH amount. Forwards payment to      InsurancePool and links the new policy into DriverRegistry.",
					"params": {
						"basePremium": "The off-chain-computed base premium, in wei, before                     the safety-score adjustment.",
						"coverageAmount": "The maximum payout coverage for this policy, in wei."
					},
					"returns": {
						"policyId": "The newly created policy ID."
					}
				},
				"renewPolicy(uint256,uint256)": {
					"details": "Only the policy's driver may renew it. Re-applies the current      safety-score tier to the newly supplied base premium. Resets      `startTime`/`expiryTime` to a fresh 365-day term and reactivates      the policy (including clearing a prior `underReview` flag if the      score has since improved).",
					"params": {
						"newBasePremium": "The off-chain-computed base premium for the                        renewal term, in wei, before score adjustment.",
						"policyId": "The policy ID to renew."
					}
				},
				"renounceRole(bytes32,address)": {
					"details": "Revokes `role` from the calling account. Roles are often managed via {grantRole} and {revokeRole}: this function's purpose is to provide a mechanism for accounts to lose their privileges if they are compromised (such as when a trusted device is misplaced). If the calling account had been revoked `role`, emits a {RoleRevoked} event. Requirements: - the caller must be `callerConfirmation`. May emit a {RoleRevoked} event."
				},
				"revokeRole(bytes32,address)": {
					"details": "Revokes `role` from `account`. If `account` had been granted `role`, emits a {RoleRevoked} event. Requirements: - the caller must have ``role``'s admin role. May emit a {RoleRevoked} event."
				},
				"supportsInterface(bytes4)": {
					"details": "Returns true if this contract implements the interface defined by `interfaceId`. See the corresponding https://eips.ethereum.org/EIPS/eip-165#how-interfaces-are-identified[ERC section] to learn more about how these ids are created. This function call must use less than 30 000 gas."
				},
				"updatePremium(uint256,uint256)": {
					"details": "Restricted to INSURANCE_COMPANY_ROLE. This is a bookkeeping      override (e.g. correcting a pricing error) and does NOT collect      or refund any ETH — it only updates the recorded premium amount.",
					"params": {
						"newPremium": "The corrected premium amount, in wei.",
						"policyId": "The policy ID to update."
					}
				}
			},
			"stateVariables": {
				"_nextPolicyId": {
					"details": "Starts at 1 so that 0 can safely mean \"no policy\" throughout the protocol."
				}
			},
			"title": "InsurancePolicy",
			"version": 1
		},
		"userdoc": {
			"errors": {
				"DriverNotRegistered(address)": [
					{
						"notice": "Thrown when referencing a wallet that has not registered as a driver."
					}
				],
				"IncorrectPremiumAmount(uint256,uint256)": [
					{
						"notice": "Thrown when the value sent does not match the required premium amount."
					}
				],
				"NotPolicyOwner(address,uint256)": [
					{
						"notice": "Thrown when a caller other than the policy's driver attempts a driver-only action."
					}
				],
				"PolicyAlreadyActive(address)": [
					{
						"notice": "Thrown when a driver already holds an active policy and tries to purchase another."
					}
				],
				"PolicyNotFound(uint256)": [
					{
						"notice": "Thrown when referencing a policy ID that does not exist."
					}
				],
				"ZeroAddress()": [
					{
						"notice": "Thrown when a zero address is passed where a non-zero address is required."
					}
				],
				"ZeroAmount()": [
					{
						"notice": "Thrown when a numeric argument is zero but must be non-zero."
					}
				]
			},
			"events": {
				"EmergencyPaused(address)": {
					"notice": "Emitted when a contract is paused in response to an emergency."
				},
				"EmergencyUnpaused(address)": {
					"notice": "Emitted when a contract is unpaused, resuming normal operations."
				},
				"PolicyCancelled(uint256,address)": {
					"notice": "Emitted when a policy is cancelled by the driver or the insurer."
				},
				"PolicyPurchased(uint256,address,uint256,uint256,uint64)": {
					"notice": "Emitted when a driver purchases a new insurance policy."
				},
				"PolicyRenewed(uint256,uint256,uint64)": {
					"notice": "Emitted when a policy is renewed."
				},
				"PremiumUpdated(uint256,uint256,uint256)": {
					"notice": "Emitted whenever a policy's premium amount is recalculated or updated."
				}
			},
			"kind": "user",
			"methods": {
				"INSURANCE_COMPANY_ROLE()": {
					"notice": "Allowed to administratively update premiums and force-cancel policies."
				},
				"PAUSER_ROLE()": {
					"notice": "Allowed to pause/unpause this contract in an emergency."
				},
				"POLICY_DURATION()": {
					"notice": "Fixed policy term applied on every purchase/renewal."
				},
				"cancelPolicy(uint256)": {
					"notice": "Cancels a policy, immediately ending coverage."
				},
				"driverRegistry()": {
					"notice": "The DriverRegistry this contract links purchased policies into."
				},
				"getPolicy(uint256)": {
					"notice": "Returns the full on-chain record for a policy."
				},
				"insurancePool()": {
					"notice": "The InsurancePool that receives forwarded premium payments."
				},
				"isPolicyActive(uint256)": {
					"notice": "Returns whether a policy is currently active."
				},
				"pause()": {
					"notice": "Pauses purchase, renewal, cancellation, and premium updates."
				},
				"purchasePolicy(uint256,uint256)": {
					"notice": "Purchases a new insurance policy for the caller."
				},
				"renewPolicy(uint256,uint256)": {
					"notice": "Renews an existing policy for another full term."
				},
				"safetyScoreOracle()": {
					"notice": "The SafetyScoreOracle this contract reads verified scores from."
				},
				"unpause()": {
					"notice": "Resumes normal operation after a pause."
				},
				"updatePremium(uint256,uint256)": {
					"notice": "Administratively overrides a policy's stored premium value."
				}
			},
			"notice": "Manages the insurance policy lifecycle (purchase, renew, cancel,         premium updates) and applies the deterministic safety-score-based         premium adjustment. Reads verified scores from SafetyScoreOracle         and links purchased policies into DriverRegistry — it performs NO         AI computation itself; scoring is entirely off-chain, this         contract only applies a fixed, auditable pricing formula to a         verified score.",
			"version": 1
		}
	},
