			},
			"events": {
				"EmergencyPaused(address)": {
					"notice": "Emitted when a contract is paused in response to an emergency."
				},
				"EmergencyUnpaused(address)": {
					"notice": "Emitted when a contract is unpaused, resuming normal operations."
				},
				"FundsDeposited(address,uint256)": {
					"notice": "Emitted when funds are deposited into the InsurancePool."
				}
			},
			"kind": "user",
			"methods": {
				"INSURANCE_COMPANY_ROLE()": {
					"notice": "May deposit funds into the pool (also open to any depositor         via `deposit`, e.g. InsurancePolicy forwarding premiums)."
				},
				"PAUSER_ROLE()": {
					"notice": "Allowed to pause/unpause this contract in an emergency."
				},
				"SPENDER_ROLE()": {
					"notice": "Granted exclusively to the ClaimManager contract address,         allowing it to trigger payouts from pool funds."
				},
				"deposit()": {
					"notice": "Deposits native ETH into the pool."
				},
				"getPoolBalance()": {
					"notice": "Returns the pool's current ETH balance."
				},
				"pause()": {
					"notice": "Pauses deposits and payouts on this contract."
				},
				"payOut(address,uint256)": {
					"notice": "Pays out an approved claim amount to a driver's wallet."
				},
				"unpause()": {
					"notice": "Resumes normal operation after a pause."
				}
			},
			"notice": "Minimal treasury contract: holds ETH collected from premiums and         insurer top-ups, and pays out approved claims. Added beyond the         original four-contract list because ClaimManager's \"automatic         payout transfer\" requirement needs funds to live somewhere on-chain         — this contract is intentionally as small as possible: no policy         logic, no claim logic, just custody and controlled disbursement.",
			"version": 1
		}
	},
